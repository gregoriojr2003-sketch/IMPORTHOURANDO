# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Mercado Livre Affiliate Tag (e.g. matext=xxxxx)
MERCADO_LIVRE_AFFILIATE_TAG="sua_tag_afiliado"

# WhatsApp Cloud API / Evolution API / Z-API credentials (optional)
WHATSAPP_API_TOKEN=""
WHATSAPP_INSTANCE_ID=""

# Supabase Credentials (Real Authentication & Database)
# Create a free project at https://supabase.com
# Configure Google OAuth provider in Supabase Auth settings
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
